{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.local/ai-engineering-workbench/task.schema.json",
  "title": "AI Engineering Workbench Task",
  "description": "YAML and JSON-compatible task schema for deterministic task validation.",
  "type": "object",
  "required": [
    "id",
    "project",
    "title",
    "type",
    "priority",
    "estimated_minutes",
    "objective",
    "acceptance_criteria"
  ],
  "additionalProperties": false,
  "properties": {
    "id": { "type": "string", "minLength": 1 },
    "project": { "type": "string", "minLength": 1 },
    "title": { "type": "string", "minLength": 1 },
    "type": {
      "type": "string",
      "enum": [
        "feature",
        "bugfix",
        "test",
        "refactor",
        "documentation",
        "security",
        "evaluation",
        "chore"
      ]
    },
    "priority": {
      "type": "string",
      "enum": ["low", "medium", "high", "critical"]
    },
    "status": {
      "type": "string",
      "enum": [
        "backlog",
        "ready",
        "in_progress",
        "blocked",
        "in_review",
        "completed",
        "cancelled"
      ]
    },
    "estimated_minutes": { "type": "integer", "minimum": 1 },
    "objective": { "type": "string", "minLength": 1 },
    "acceptance_criteria": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "constraints": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "expected_paths": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "required_checks": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "portfolio_signals": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "dependencies": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "blocking_reason": { "type": ["string", "null"] },
    "target_branch": { "type": ["string", "null"] }
  }
}
